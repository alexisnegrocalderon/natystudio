{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/pilot-services.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/admin/*.ts": {
      "maxDuration": 10
    }
  }
}

# Este paquete ya no se despliega solo — su lógica corre dentro de apps/web.
# Este archivo sólo sirve para los scripts de mantenimiento de la base que se
# corren a mano (`pnpm db:migrate`, `pnpm db:seed`). Para las variables de
# tiempo de ejecución del sitio, ver apps/web/.env.example.

# Copia la cadena POOLED desde Neon → Connection Details (la que trae "-pooler"
# en el host). `sslmode=require` no es opcional: Neon rechaza conexiones sin TLS.
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Siembra inicial (sólo para `pnpm db:seed`) ──────────────────────────────
ADMIN_EMAIL=
# Si se deja vacío, el seed genera una contraseña y la muestra una única vez.
ADMIN_PASSWORD=

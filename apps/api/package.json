{
  "name": "@naty/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/routers/index.ts",
  "types": "./src/routers/index.ts",
  "exports": {
    ".": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@naty/shared": "workspace:*",
    "@trpc/server": "^11.6.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "nanoid": "^5.1.5",
    "node-cron": "^3.0.3",
    "otpauth": "^9.4.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3"
  }
}

# ─── Base de datos (Neon) ────────────────────────────────────────────────────
# Copia la cadena POOLED desde Neon → Connection Details (la que trae "-pooler"
# en el host). La directa se satura con varias conexiones abiertas.
# `sslmode=require` no es opcional: Neon rechaza conexiones sin TLS.
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Orígenes autorizados para CORS, separados por coma. En producción va el
# dominio de Vercel; nunca un comodín, porque las peticiones del panel llevan
# cookie de sesión.
WEB_ORIGIN=http://localhost:3000

# URL pública del sitio, usada para armar los enlaces de los correos.
SITE_URL=http://localhost:3000

# ─── Sesión del panel ────────────────────────────────────────────────────────
# Cadena larga y aleatoria. Generar con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ─── Siembra inicial (sólo para `pnpm db:seed`) ──────────────────────────────
ADMIN_EMAIL=
# Si se deja vacío, el seed genera una contraseña y la muestra una única vez.
ADMIN_PASSWORD=

# ─── Correo (Resend) ─────────────────────────────────────────────────────────
# Sin esta clave el sistema NO envía correos: los registra en consola y sigue
# funcionando. Es el modo esperado mientras no exista dominio verificado.
RESEND_API_KEY=
# Sin dominio verificado, Resend sólo permite enviar desde onboarding@resend.dev
# y únicamente hacia la casilla dueña de la cuenta.
MAIL_FROM=naty.studio <onboarding@resend.dev>
# Casilla donde Naty recibe el aviso de cada reserva nueva.
ADMIN_NOTIFY_EMAIL=

# ─── Revalidación de páginas estáticas ───────────────────────────────────────
# Debe coincidir con REVALIDATE_SECRET en apps/web.
REVALIDATE_SECRET=

# ─── Mercado Pago (aún apagado) ──────────────────────────────────────────────
# Mantener en false hasta tener credenciales. Con los pagos apagados la reserva
# queda pendiente de aprobación y Naty la confirma a mano.
PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

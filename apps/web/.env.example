# Este es ahora el único proyecto que se despliega: el backend (tRPC, correos,
# cron de recordatorios) corre dentro de sus propias rutas de API, no en un
# servicio aparte.

# ─── Base de datos (Neon) ────────────────────────────────────────────────────
# Cadena POOLED (con "-pooler" en el host). sslmode=require no es opcional.
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Sitio ────────────────────────────────────────────────────────────────────
# URL canónica. Se usa para los canonical, el sitemap, Open Graph y los enlaces
# dentro de los correos. Mientras no exista dominio propio, Vercel la completa
# sola con VERCEL_URL si se deja vacía.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interruptor de indexación. Mantener en "false" hasta que el dominio real esté
# configurado: si Google indexa el sitio bajo *.vercel.app, esas URLs quedan
# compitiendo con el dominio definitivo y sacarlas del índice cuesta semanas.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Opcional: URL de la fotografía de Naty para el hero. Si se deja vacío se
# muestra el monograma en lugar de una imagen rota.
NEXT_PUBLIC_PORTRAIT_URL=

# ─── Sesión del panel ────────────────────────────────────────────────────────
# Cadena larga y aleatoria. Generar con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ─── Recordatorios programados ───────────────────────────────────────────────
# Protege /api/cron: sin este valor coincidiendo, cualquiera podría forzar el
# reenvío repetido de recordatorios. Un servicio externo (p. ej. cron-job.org)
# debe llamar a /api/cron?key=<este valor> cada 5 minutos.
CRON_SECRET=

# ─── Correo (Resend) ─────────────────────────────────────────────────────────
# Sin esta clave el sistema NO envía correos: los registra en consola y sigue
# funcionando. Es el modo esperado mientras no exista dominio verificado.
RESEND_API_KEY=
# Sin dominio verificado, Resend sólo permite enviar desde onboarding@resend.dev
# y únicamente hacia la casilla dueña de la cuenta.
MAIL_FROM=naty.studio <onboarding@resend.dev>
# Casilla donde Naty recibe el aviso de cada reserva nueva.
ADMIN_NOTIFY_EMAIL=

# ─── Revalidación de páginas estáticas ───────────────────────────────────────
# El propio panel llama a /api/revalidate al guardar cambios; este valor lo
# protege de llamadas externas.
REVALIDATE_SECRET=

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Mantener en false hasta tener credenciales. Con los pagos apagados la reserva
# queda pendiente de aprobación y Naty la confirma a mano; con PAYMENTS_ENABLED
# en true, un servicio con precio pasa por el paso de pago (Payment Brick
# embebido en /reservar) antes de confirmarse.
#
# Las tres credenciales salen del mismo lugar: panel de Mercado Pago →
# "Tus integraciones" → tu aplicación → "Credenciales de producción" (o "de
# prueba" mientras se prueba). MP_WEBHOOK_SECRET es la "clave secreta" que
# aparece al configurar la notificación de webhooks para esa aplicación —sin
# ella el webhook no puede validar su firma y queda inerte, aunque los pagos
# igual se confirman por la respuesta en línea y por el reconciliador del cron.
#
# La URL del webhook a registrar en el panel de Mercado Pago (evento "Pagos"):
# https://tudominio.cl/api/webhooks/mercadopago
PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Split de pagos (marketplace): la "Aplicación" de Mercado Pago que ya tienes
# creada, para que Naty conecte su propia cuenta desde Ajustes por OAuth y a
# cada cobro se le sume automáticamente tu comisión (1.5%) además de la de
# Mercado Pago. Salen del panel de Mercado Pago → "Tus integraciones" → tu
# aplicación → "Credenciales de producción" (Client ID / Client secret, no
# confundir con el Access Token/Public Key de arriba, que son de la cuenta
# fija). Sin estas dos, el botón "Conectar Mercado Pago" en Ajustes queda
# apagado y los pagos no se dividen.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ─── Redacción con IA (mailing y descripciones de servicios) ────────────────
# Clave gratuita desde aistudio.google.com/apikey (Google AI Studio, nivel
# gratis con límites generosos). Vacío = los botones de IA quedan apagados,
# el resto del sitio sigue funcionando igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Fotos de servicios (Vercel Blob) ────────────────────────────────────────
# Se genera solo al activar "Blob" en el dashboard de Vercel para este
# proyecto (Storage → Create Database → Blob). Vacío = el form de servicios
# no ofrece subir foto todavía.
BLOB_READ_WRITE_TOKEN=

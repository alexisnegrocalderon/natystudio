# URL del API (Railway en producción, local en desarrollo).
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL canónica del sitio. Se usa para los canonical, el sitemap y Open Graph.
# Mientras no exista dominio propio, Vercel la completa sola con VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interruptor de indexación. Mantener en "false" hasta que el dominio real esté
# configurado: si Google indexa el sitio bajo *.vercel.app, esas URLs quedan
# compitiendo con el dominio definitivo y sacarlas del índice cuesta semanas.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Debe coincidir con REVALIDATE_SECRET en apps/api. Permite que el panel
# refresque las páginas estáticas al guardar un cambio.
REVALIDATE_SECRET=

# Opcional: URL de la fotografía de Naty para el hero. Si se deja vacío se
# muestra el monograma en lugar de una imagen rota.
NEXT_PUBLIC_PORTRAIT_URL=
